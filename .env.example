# Deepgram Flux (STT) — also reused for the "deepgram" TTS option below
DEEPGRAM_API_KEY=

# LLMs via OpenRouter (OpenAI-compatible).
OPENROUTER_API_KEY=
# Turn-by-turn conversation model (spoken reply + live coaching) —
# latency-critical. deepseek-v4-flash: ~1s to first token and ~4x cheaper
# than the reasoning model, which is no faster here (the OpenRouter hop
# dominates). Leave unset to use the code default (also flash).
OPENROUTER_TURN_MODEL=deepseek/deepseek-v4-flash
# End-of-session report model — quality over speed; a reasoning model is fine.
OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# Audio observer (bilingual mode + pronunciation feedback) — an audio-native
# model via OpenRouter (reuses OPENROUTER_API_KEY, no separate key needed).
OPENROUTER_OBSERVER_MODEL=google/gemini-3.6-flash
# Local dev only: OpenRouter blocks Gemini from some regions. Set a proxy that
# exits via an allowed region (e.g. http://127.0.0.1:12334). Leave empty on
# Vercel — its servers are already in an allowed region.
OPENROUTER_PROXY=

# TTS provider: azure | elevenlabs | deepgram | cartesia
TTS_PROVIDER=azure

# Azure TTS (default — cheapest of the four, with a free monthly allowance)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_VOICE=en-US-JennyNeural

# ElevenLabs TTS (alternate — most expressive voices, priciest)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Deepgram Aura-2 TTS (alternate — reuses DEEPGRAM_API_KEY above)
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Cartesia TTS (alternate — lowest latency; voice id from your Cartesia voice library)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL_ID=sonic-3.5
