# Deepgram Flux (STT) — also reused for the "deepgram" TTS option below
DEEPGRAM_API_KEY=

# Dialogue + coaching feedback LLM
DEEPSEEK_API_KEY=

# TTS provider: azure | elevenlabs | deepgram | cartesia
TTS_PROVIDER=azure

# Azure TTS (default — cheapest of the four, with a free monthly allowance)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_VOICE=en-US-JennyNeural

# ElevenLabs TTS (alternate — most expressive voices, priciest)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Deepgram Aura-2 TTS (alternate — reuses DEEPGRAM_API_KEY above)
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Cartesia TTS (alternate — lowest latency; voice id from your Cartesia voice library)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL_ID=sonic-3.5
